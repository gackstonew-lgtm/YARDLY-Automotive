# ============================================================
# YARDLY AUTOMOTIVES ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# NOTICE:
# - Client-side variables (browser accessible) MUST be prefixed with VITE_
# - Server-side only variables MUST NEVER be prefixed with VITE_
# ============================================================

# Frontend Client Configuration (Public / Browser Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Side Backend Configuration (Secret / Server Only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
